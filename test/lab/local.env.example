# Copy to local.env (ignored by git) and fill in. Placeholders only: 192.0.2.0/24, 198.51.100.0/24 and
# 203.0.113.0/24 are documentation ranges; use your own lab values locally, never commit them.
USER_VM=labuser                    # account in the lab VMs
CT130=user@192.0.2.10              # ssh target of the tunnel test server
LAB_ENDPOINTS="192.0.2.10:51820/udp"
LAB_VPN_DIR=$HOME/.config/shunt-testserver   # folder with wg-intern-linux-test.conf etc. (test keys)

# attacker VM (Kali)
KALI_PORT=2226                     # host port forwarded to Kali's ssh
KALI_USER=lab
KALI_IP=192.0.2.222                # fixed address of Kali in the lab LAN, OUTSIDE the DHCP pool (100-199);
                                   # use the lab network's own private range (default 10.77.0.222)

# defense tests (R04 rogue DHCP, R05 DNS hijack, R06 beacon/tunnel)
DEFENSE_POOL_START=192.0.2.150     # rogue DHCP pool: outside the real pool, inside the lab LAN
DEFENSE_POOL_END=192.0.2.160
DEFENSE_POOL_ROUTER=192.0.2.222    # router the rogue server hands out (usually Kali)
DEFENSE_FAKE_IP=198.51.100.66      # address the hijacked DNS answers carry
DEFENSE_BEACON_DEST=203.0.113.9    # beacon target outside the tunnel
DEFENSE_TUNNEL_DOMAIN=tunnel.example.test   # domain for the DNS-tunnel pattern
DEFENSE_ALT_LAST=250               # Q02: last octet of the scanner's second address

# optional
#BUILD_CHECK=warn                  # warn (default) | strict | off: compare the client build with git HEAD
#PREP_APT_TIMEOUT=60               # client-prep: seconds for apt-get update (no internet in the lab LAN)
#CLIENT_CAP=80
#GW_CAP=80
