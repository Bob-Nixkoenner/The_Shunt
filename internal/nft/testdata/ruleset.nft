table inet shunt
delete table inet shunt
table inet shunt {
	set dom2_v4a {
		type ipv4_addr; flags timeout;
	}
	set dom2_v6a {
		type ipv6_addr; flags timeout;
	}
	set dom2_v4b {
		type ipv4_addr; flags timeout;
	}
	set dom2_v6b {
		type ipv6_addr; flags timeout;
	}
	chain route_out {
		type route hook output priority mangle; policy accept;
		meta mark 0x5300ff return
		meta mark and 0xffff00 == 0x530000 ct mark set meta mark return
		meta l4proto tcp ct mark and 0xffff00 == 0x530000 meta mark set ct mark return
		ct direction reply oifname != "lo" ct mark and 0xffff00 == 0x530000 meta mark set ct mark return
		ct direction reply return
		oifname "lo" meta l4proto != { tcp, udp } return
		oifname "lo" th dport != 53 return
		socket cgroupv2 level 3 "system.slice/shuntd.service/daemon" return
		socket cgroupv2 level 4 "system.slice/shuntd.service/apps/captive" meta mark set 0x5300f1 ct mark set meta mark accept
		socket cgroupv2 level 5 "system.slice/shuntd.service/apps/via/block" meta mark set 0x5300fe ct mark set meta mark accept
		socket cgroupv2 level 5 "system.slice/shuntd.service/apps/via/direct" meta mark set 0x5300f0 ct mark set meta mark accept
		socket cgroupv2 level 5 "system.slice/shuntd.service/apps/via/tunnel-home" meta mark set 0x530001 ct mark set meta mark accept
		socket cgroupv2 level 5 "system.slice/shuntd.service/apps/via/tunnel-vps" meta mark set 0x530002 ct mark set meta mark accept
		socket cgroupv2 level 5 "system.slice/shuntd.service/apps/via/link-wifi" meta mark set 0x5300e0 ct mark set meta mark accept
		socket cgroupv2 level 5 "system.slice/shuntd.service/apps/via/link-ethernet" meta mark set 0x5300e1 ct mark set meta mark accept
		socket cgroupv2 level 5 "system.slice/shuntd.service/apps/via/link-mobile" meta mark set 0x5300e2 ct mark set meta mark accept
		meta l4proto tcp th dport { 22 } meta mark set 0x5300f0 ct mark set meta mark accept
		ip daddr @dom2_v4a meta l4proto tcp th dport { 443 } meta mark set 0x5300f0 ct mark set meta mark accept
		ip daddr @dom2_v4b meta l4proto tcp th dport { 443 } meta mark set 0x5300f0 ct mark set meta mark accept
		ip6 daddr @dom2_v6a meta l4proto tcp th dport { 443 } meta mark set 0x5300f0 ct mark set meta mark accept
		ip6 daddr @dom2_v6b meta l4proto tcp th dport { 443 } meta mark set 0x5300f0 ct mark set meta mark accept
		ip daddr { 192.168.1.0/24 } meta mark set 0x530001 ct mark set meta mark accept
		ip6 daddr { fd00:1::/64 } meta mark set 0x530001 ct mark set meta mark accept
		socket cgroupv2 level 5 "system.slice/shuntd.service/apps/g/torrent" meta l4proto tcp th dport { 6881 } meta mark set 0x530002 ct mark set meta mark accept
		socket cgroupv2 level 5 "system.slice/shuntd.service/apps/g/torrent" meta l4proto udp th dport { 6881-6889 } meta mark set 0x530002 ct mark set meta mark accept
		meta mark set 0x530002 ct mark set meta mark accept
	}
	chain mark_in {
		type filter hook prerouting priority mangle; policy accept;
		iifname "lo" return
		iifname "sh-home" ct state new ct mark set 0x530001
		iifname "sh-vps" ct state new ct mark set 0x530002
		ct mark and 0xffff00 == 0x530000 meta mark set ct mark
	}
	chain ask_out {
	}
	chain filter_out {
		type filter hook output priority filter; policy accept;
		meta mark 0x5300fe counter reject with icmpx admin-prohibited
		oifname != "lo" jump ask_out
		socket cgroupv2 level 3 "system.slice/shuntd.service/daemon" accept
		meta l4proto { tcp, udp } th dport 853 counter reject with icmpx admin-prohibited
	}
	chain dns_redirect {
		type nat hook output priority dstnat; policy accept;
		socket cgroupv2 level 3 "system.slice/shuntd.service/daemon" return
		meta mark 0x5300f0 meta l4proto { tcp, udp } th dport 53 redirect to :53530
		meta mark 0x530001 meta l4proto { tcp, udp } th dport 53 redirect to :53532
		meta mark 0x530002 meta l4proto { tcp, udp } th dport 53 redirect to :53533
		meta mark 0x5300e0 meta l4proto { tcp, udp } th dport 53 redirect to :53534
		meta mark 0x5300e1 meta l4proto { tcp, udp } th dport 53 redirect to :53535
		meta mark 0x5300e2 meta l4proto { tcp, udp } th dport 53 redirect to :53536
		meta mark 0x5300f1 meta l4proto { tcp, udp } th dport 53 redirect to :53529
		meta mark and 0xffff00 != 0x530000 meta l4proto { tcp, udp } th dport 53 redirect to :53530
	}
	chain leak_guard {
		type filter hook postrouting priority filter; policy accept;
		meta mark 0x530001 oifname != { "sh-home", "lo" } counter drop
		meta mark 0x530002 oifname != { "sh-vps", "lo" } counter drop
		meta mark 0x5300e0 oifname != "lo" counter drop
		meta mark 0x5300e1 oifname != "lo" counter drop
		meta mark 0x5300e2 oifname != "lo" counter drop
	}
	chain mss_clamp {
		type filter hook postrouting priority mangle; policy accept;
		oifname "sh-home" tcp flags syn / syn,rst tcp option maxseg size set rt mtu
		oifname "sh-vps" tcp flags syn / syn,rst tcp option maxseg size set rt mtu
	}
	chain nat_post {
		type nat hook postrouting priority srcnat; policy accept;
		meta mark 0x530001 oifname "sh-home" masquerade
		meta mark 0x530002 oifname "sh-vps" masquerade
	}
}
