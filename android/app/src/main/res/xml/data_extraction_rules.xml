<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" no longer stops device-to-device
     transfer. Tunnel configs hold private keys and logins, so nothing of
     the app leaves the phone, neither to the cloud nor to a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
