[Unit]
Description=Shunt split-tunneling daemon
Documentation=https://github.com/Bob-Nixkoenner/the_shunt
Wants=network-pre.target
After=network-pre.target shunt-lockdown.service
Before=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/shuntd -c /etc/shunt/shunt.toml run
ExecReload=/bin/kill -HUP $MAINPID
# shuntd owns the cgroup subtree below its unit (apps are moved there)
Delegate=yes
# Stopping/restarting shuntd must not kill the user's apps that live in its
# cgroup subtree. Their traffic stays classified (and kill-switched) meanwhile.
KillMode=process
RuntimeDirectory=shunt
RuntimeDirectoryMode=0755
# DNS filter blocklists (downloaded only while a filter level uses them)
CacheDirectory=shunt
# traffic totals per tunnel and month (internal/stats)
StateDirectory=shunt
Restart=on-failure
RestartSec=2
# shuntd starts before NetworkManager (boot lockdown), so /run/NetworkManager
# does not exist yet. ReadWritePaths=-/run/NetworkManager below is skipped for
# a missing directory and ProtectSystem=strict keeps /run read-only, so the
# connection defaults could not be written. "+" runs outside the sandbox, "-"
# lets shuntd start anyway if this fails (the lockdown must not wait).
ExecStartPre=-+/usr/bin/mkdir -p /run/NetworkManager/conf.d

# Hardening. Root uid is needed to own the delegated cgroups and to move
# other users' processes into them, but capabilities are cut to networking.
# CAP_BPF + CAP_PERFMON (reading a process name in eBPF, tracepoints) +
# bpf() + perf_event_open() (attaching the exec/fork/exit tracepoints, read
# from tracefs): the start guard (internal/racebpf), optional.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_CHOWN CAP_BPF CAP_PERFMON
NoNewPrivileges=yes
ProtectSystem=strict
# -/run/NetworkManager: connection defaults for new networks (daemon.mac);
# -/var/lib/NetworkManager: forget old DHCP leases with mac = "random"
ReadWritePaths=/run/shunt /etc/shunt -/run/NetworkManager -/var/lib/NetworkManager
ProtectHome=yes
ProtectKernelLogs=yes
ProtectProc=default
UMask=0077
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
KeyringMode=private
PrivateIPC=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=bpf perf_event_open
# Not set on purpose: ProtectKernelTunables (needs /proc/sys/net),
# ProtectControlGroups (needs to write its cgroups), PrivateDevices (/dev/net/tun).

[Install]
WantedBy=multi-user.target
