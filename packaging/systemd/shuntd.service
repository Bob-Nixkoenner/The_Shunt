[Unit]
Description=Shunt split-tunneling daemon
Documentation=https://github.com/Bob-Nixkoenner/the_shunt
Wants=network-pre.target
After=network-pre.target shunt-lockdown.service
Before=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/shuntd -c /etc/shunt/shunt.toml run
ExecReload=/bin/kill -HUP $MAINPID
# shuntd owns the cgroup subtree below its unit (apps are moved there)
Delegate=yes
# Stopping/restarting shuntd must not kill the user's apps that live in its
# cgroup subtree. Their traffic stays classified (and kill-switched) meanwhile.
KillMode=process
RuntimeDirectory=shunt
RuntimeDirectoryMode=0755
# DNS filter blocklists (downloaded only while a filter level uses them)
CacheDirectory=shunt
# traffic totals per tunnel and month (internal/stats)
StateDirectory=shunt
Restart=on-failure
RestartSec=2
# shuntd starts before NetworkManager (boot lockdown), so /run/NetworkManager
# does not exist yet. ReadWritePaths=-/run/NetworkManager below is skipped for
# a missing directory and ProtectSystem=strict keeps /run read-only, so the
# connection defaults could not be written. "+" runs outside the sandbox, "-"
# lets shuntd start anyway if this fails (the lockdown must not wait).
ExecStartPre=-+/usr/bin/mkdir -p /run/NetworkManager/conf.d

# Hardening. Root uid is needed to own the delegated cgroups and to move
# other users' processes into them, but capabilities are cut to networking.
# CAP_BPF + CAP_PERFMON (reading a process name in eBPF, tracepoints) +
# bpf() + perf_event_open() (attaching the exec/fork/exit tracepoints, read
# from tracefs): the start guard (internal/racebpf), optional.
# CAP_NET_BIND_SERVICE: decoy ports below 1024 (defense, public networks
# only); CAP_NET_RAW + AF_PACKET: watching ARP/DHCP replies (defense).
CapabilityBoundingSet=CAP_NET_ADMIN CAP_CHOWN CAP_BPF CAP_PERFMON CAP_NET_BIND_SERVICE CAP_NET_RAW
# kernels before 5.11 charge eBPF maps to RLIMIT_MEMLOCK; shuntd cannot
# raise it itself (no CAP_SYS_RESOURCE), so the start guard needs room here
LimitMEMLOCK=infinity
NoNewPrivileges=yes
ProtectSystem=strict
# -/run/NetworkManager: connection defaults for new networks (daemon.mac);
# -/var/lib/NetworkManager: forget old DHCP leases with mac = "random"
ReadWritePaths=/run/shunt /etc/shunt -/run/NetworkManager -/var/lib/NetworkManager
ProtectHome=yes
ProtectKernelLogs=yes
ProtectProc=default
UMask=0077
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
KeyringMode=private
PrivateIPC=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=bpf perf_event_open
# adjtimex, read-only: the evidence log notes whether the clock is
# synchronised (internal/defense/evidence, on with Max Security). Without this
# line the first call killed shuntd (SIGSYS) at every start. The clock still
# cannot be set: that needs CAP_SYS_TIME, which is outside the bounding set
# above and cannot come back (NoNewPrivileges), and the calls that only set
# it (settimeofday, clock_settime, clock_adjtime) stay outside this list.
SystemCallFilter=adjtimex
# A call outside the list fails with "not permitted" instead of killing the
# daemon: one forgotten call in a rarely used path, or a new one in a library
# or a child program, must not end in a restart loop with no socket left to
# switch the setting off again.
SystemCallErrorNumber=EPERM
# Not set on purpose: ProtectKernelTunables (needs /proc/sys/net),
# ProtectControlGroups (needs to write its cgroups), PrivateDevices (/dev/net/tun),
# ProtectClock (it blocks adjtimex altogether, reading included; setting the
# clock is ruled out by the missing CAP_SYS_TIME, see above).

[Install]
WantedBy=multi-user.target
