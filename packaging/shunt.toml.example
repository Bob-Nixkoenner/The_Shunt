# /etc/shunt/shunt.toml
[daemon]
socket       = "/run/shunt/shuntd.sock"
socket_group = "shunt"      # members may use the `shunt` CLI
default_route = "direct"    # direct | block | tunnel:<name>

# wg-quick style file, mode 0600. PostUp/PreUp/Table/FwMark are ignored.
[tunnel.vps]
config = "/etc/shunt/tunnels/vps.conf"
# driver = "auto"           # auto | kernel | userspace

# DNS filter: blocklists inside Shunt (lists: github.com/RPiList/specials – thanks!).
# Without this section: everything "normal" = EasyList. Levels can also be set per
# tunnel, per [[network]] and per [[rule]] (dns_filter = "off|low|normal|paranoid").
# [dns_filter]
# default  = "normal"
# low      = []
# normal   = ["easylist"]
# paranoid = ["easylist", "Phishing-Angriffe", "malware", "Win10Telemetry", "MS-Office-Telemetry", "crypto"]
# allow    = ["example.com"]

[group.torrent]
description = "start with: shunt run --group torrent -- qbittorrent"

# Rules: first match wins. Selectors of different kinds are ANDed,
# list entries are ORed. After these come the implicit `shunt run --via` rules,
# then default_route.
[[rule]]
name  = "SSH always direct"
port  = ["tcp/22"]
route = "direct"

[[rule]]
name  = "Torrent only through the VPS"
group = ["torrent"]
route = "tunnel:vps"
